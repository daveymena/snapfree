# SnapFree SaaS — variables de entorno
# Copia a .env en el servidor (Render/Fly: ponlas en el dashboard).

# Obligatoria en producción (cualquiera larga y secreta)
JWT_SECRET=cambia-esto-por-algo-largo-y-secreto

# URL pública de tu backend (para que PayPal/MP vuelvan y avisen)
BASE_URL=http://localhost:3000

# PostgreSQL (EasyPanel: host interno del servicio, no el puerto público)
DATABASE_URL=postgresql://postgres:password@postgres:5432/snapfree

# Plan gratis: descargas por día
FREE_DAILY=5

# Precios PRO en USD
PRO_MONTHLY_USD=2.99
PRO_YEARLY_USD=19.99

# PayPal (developer.paypal.com -> tu app -> Client ID + Secret; empieza en sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# MercadoPago (tu cuenta -> Credenciales -> Access Token de PRODUCCIÓN o prueba)
MP_ACCESS_TOKEN=

# (Opcional) Clave de instancia Cobalt con acceso API
COBALT_API_KEY=

# YouTube (opcional): exporta cookies.txt de una cuenta secundaria.
# Guarda su contenido Netscape con los saltos de línea escritos como \n en EasyPanel.
# No uses la cuenta principal ni publiques esta variable.
YTDLP_COOKIES=

# Alternativa de pago si YouTube sigue bloqueando la salida del servidor.
# YTDLP_PROXY=http://usuario:clave@proxy-host:puerto
